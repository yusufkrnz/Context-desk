{
  "name": "context-desk",
  "version": "0.1.1",
  "description": "See what your AI coding sessions actually looked like: context growth, compactions, corrections and rule files. Runs locally, uploads nothing.",
  "author": "Yusuf Kurnaz",
  "homepage": "https://github.com/yusufkrnz/Context-desk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufkrnz/Context-desk.git"
  },
  "bugs": {
    "url": "https://github.com/yusufkrnz/Context-desk/issues"
  },
  "type": "module",
  "bin": {
    "context-desk": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.cli.json && vite build",
    "dev:ui": "vite",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.cli.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "start": "node dist/cli/index.js",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "claude-code",
    "claude",
    "context-window",
    "llm",
    "ai-agents",
    "CLAUDE.md",
    "AGENTS.md",
    "cursor-rules",
    "developer-tools",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
